# Copy to .env (setup-and-run.ps1 does this for you and generates the secrets).
# .env is git-ignored. Never commit real values.
POSTGRES_PASSWORD=generated-by-setup-script
JWT_SECRET=generated-by-setup-script
# Optional. Paste your Google AI Studio key to enable the Gemini assistant.
# Leave empty to use the built-in assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
